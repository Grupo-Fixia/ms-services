{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fixia.local/schemas/events/servicio.finalizado.v1.schema.json",
  "title": "servicio.finalizado (versión 1)",
  "description": "El prestador contratado declaró que terminó el trabajo: la solicitud pasó de IN_PROGRESS a TECHNICIAN_FINISHED (RF-047, GC-441). No es el cierre: lo confirma el cliente o lo objeta. Las evidencias son opcionales; cuando GC-439 las incorpore, agregará un campo opcional evidenceCount sin cambiar la versión. Repetir la declaración sobre un servicio ya finalizado no genera otro evento.",
  "allOf": [
    {
      "$ref": "https://fixia.local/schemas/events/envelope.v1.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "servicio.finalizado"
    },
    "schemaVersion": {
      "const": 1
    },
    "actor": {
      "properties": {
        "role": {
          "const": "PROFESSIONAL"
        }
      }
    },
    "data": {
      "type": "object",
      "required": [
        "contractId",
        "serviceRequestId",
        "clientId",
        "providerId",
        "finishedAt",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "contractId": {
          "$ref": "https://fixia.local/schemas/events/common.v1.schema.json#/$defs/uuid"
        },
        "serviceRequestId": {
          "$ref": "https://fixia.local/schemas/events/common.v1.schema.json#/$defs/uuid"
        },
        "clientId": {
          "$ref": "https://fixia.local/schemas/events/common.v1.schema.json#/$defs/uuid"
        },
        "providerId": {
          "$ref": "https://fixia.local/schemas/events/common.v1.schema.json#/$defs/uuid"
        },
        "finishedAt": {
          "$ref": "https://fixia.local/schemas/events/common.v1.schema.json#/$defs/instant"
        },
        "status": {
          "const": "TECHNICIAN_FINISHED"
        }
      }
    }
  }
}
