{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fixia.local/schemas/events/servicio.iniciado.v1.schema.json",
  "title": "servicio.iniciado (versión 1)",
  "description": "El prestador contratado inició el servicio: la solicitud pasó de CONTRACTED a IN_PROGRESS (RF-045, GC-437). El evento se escribe en la misma transacción que el cambio de estado y que su anotación en el historial. Repetir el inicio sobre un servicio ya en curso no genera otro evento.",
  "allOf": [
    {
      "$ref": "https://fixia.local/schemas/events/envelope.v1.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "servicio.iniciado"
    },
    "schemaVersion": {
      "const": 1
    },
    "actor": {
      "properties": {
        "role": {
          "const": "PROFESSIONAL"
        }
      }
    },
    "data": {
      "type": "object",
      "required": [
        "contractId",
        "serviceRequestId",
        "clientId",
        "providerId",
        "startedAt",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "contractId": {
          "$ref": "https://fixia.local/schemas/events/common.v1.schema.json#/$defs/uuid"
        },
        "serviceRequestId": {
          "$ref": "https://fixia.local/schemas/events/common.v1.schema.json#/$defs/uuid"
        },
        "clientId": {
          "$ref": "https://fixia.local/schemas/events/common.v1.schema.json#/$defs/uuid"
        },
        "providerId": {
          "$ref": "https://fixia.local/schemas/events/common.v1.schema.json#/$defs/uuid"
        },
        "startedAt": {
          "$ref": "https://fixia.local/schemas/events/common.v1.schema.json#/$defs/instant"
        },
        "status": {
          "const": "IN_PROGRESS"
        }
      }
    }
  }
}
