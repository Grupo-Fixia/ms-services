{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fixia.local/schemas/events/prestador.seleccionado.v1.schema.json",
  "title": "prestador.seleccionado (versión 1)",
  "description": "El cliente eligió un prestador entre los postulantes (RF-026 a RF-028, RN-003). En la misma transacción las demás postulaciones quedan rechazadas. Seleccionar no es contratar.",
  "allOf": [
    {
      "$ref": "https://fixia.local/schemas/events/envelope.v1.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "prestador.seleccionado"
    },
    "schemaVersion": {
      "const": 1
    },
    "actor": {
      "properties": {
        "role": {
          "const": "CLIENT"
        }
      }
    },
    "data": {
      "type": "object",
      "required": [
        "serviceRequestId",
        "clientId",
        "selectedApplicationId",
        "selectedProviderId",
        "selectedProposedPrice",
        "rejectedApplicationIds",
        "selectedAt",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "serviceRequestId": {
          "$ref": "https://fixia.local/schemas/events/common.v1.schema.json#/$defs/uuid"
        },
        "clientId": {
          "$ref": "https://fixia.local/schemas/events/common.v1.schema.json#/$defs/uuid"
        },
        "selectedApplicationId": {
          "$ref": "https://fixia.local/schemas/events/common.v1.schema.json#/$defs/uuid"
        },
        "selectedProviderId": {
          "$ref": "https://fixia.local/schemas/events/common.v1.schema.json#/$defs/uuid"
        },
        "selectedProposedPrice": {
          "oneOf": [
            {
              "$ref": "https://fixia.local/schemas/events/common.v1.schema.json#/$defs/money"
            },
            {
              "type": "null"
            }
          ],
          "description": "Precio que había propuesto el elegido; null si su postulación es anterior a GC-423."
        },
        "rejectedApplicationIds": {
          "type": "array",
          "items": {
            "$ref": "https://fixia.local/schemas/events/common.v1.schema.json#/$defs/uuid"
          },
          "uniqueItems": true
        },
        "selectedAt": {
          "$ref": "https://fixia.local/schemas/events/common.v1.schema.json#/$defs/instant"
        },
        "status": {
          "const": "PROVIDER_SELECTED"
        },
        "selectedProviderType": {
          "type": "string",
          "enum": [
            "INDEPENDENT",
            "COMPANY"
          ],
          "description": "Opcional (GC-468). Si el elegido es un técnico independiente o una empresa."
        },
        "selectedTechnicianId": {
          "oneOf": [
            {
              "$ref": "https://fixia.local/schemas/events/common.v1.schema.json#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ],
          "description": "Opcional (GC-468). Técnico ejecutor propuesto por la empresa elegida; null si es independiente."
        }
      }
    }
  }
}
