{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fixia.local/schemas/events/servicio.cerrado.v1.schema.json",
  "title": "servicio.cerrado (versión 1)",
  "description": "El cliente confirmó el cierre: la solicitud pasó de TECHNICIAN_FINISHED a CLOSED (RF-048, GC-441). Es definitivo y habilita la evaluación posterior; un servicio cerrado no se reabre. Confirmar un servicio ya cerrado no genera otro evento.",
  "allOf": [
    {
      "$ref": "https://fixia.local/schemas/events/envelope.v1.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "servicio.cerrado"
    },
    "schemaVersion": {
      "const": 1
    },
    "actor": {
      "properties": {
        "role": {
          "const": "CLIENT"
        }
      }
    },
    "data": {
      "type": "object",
      "required": [
        "contractId",
        "serviceRequestId",
        "clientId",
        "providerId",
        "closedAt",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "contractId": {
          "$ref": "https://fixia.local/schemas/events/common.v1.schema.json#/$defs/uuid"
        },
        "serviceRequestId": {
          "$ref": "https://fixia.local/schemas/events/common.v1.schema.json#/$defs/uuid"
        },
        "clientId": {
          "$ref": "https://fixia.local/schemas/events/common.v1.schema.json#/$defs/uuid"
        },
        "providerId": {
          "$ref": "https://fixia.local/schemas/events/common.v1.schema.json#/$defs/uuid"
        },
        "closedAt": {
          "$ref": "https://fixia.local/schemas/events/common.v1.schema.json#/$defs/instant"
        },
        "status": {
          "const": "CLOSED"
        }
      }
    }
  }
}
