{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fixia.local/schemas/events/cotizacion.enviada.v1.schema.json",
  "title": "cotizacion.enviada (versión 1)",
  "description": "El prestador seleccionado envió una cotización formal (RF-031). La cotización enviada que estaba vigente queda reemplazada o vencida en la misma transacción.",
  "allOf": [
    {
      "$ref": "https://fixia.local/schemas/events/envelope.v1.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "cotizacion.enviada"
    },
    "schemaVersion": {
      "const": 1
    },
    "actor": {
      "properties": {
        "role": {
          "const": "PROFESSIONAL"
        }
      }
    },
    "data": {
      "type": "object",
      "required": [
        "quotationId",
        "serviceRequestId",
        "clientId",
        "providerId",
        "price",
        "scope",
        "conditions",
        "agreedAt",
        "validUntil",
        "sentAt",
        "status",
        "replacedQuotations"
      ],
      "additionalProperties": false,
      "properties": {
        "quotationId": {
          "$ref": "https://fixia.local/schemas/events/common.v1.schema.json#/$defs/uuid"
        },
        "serviceRequestId": {
          "$ref": "https://fixia.local/schemas/events/common.v1.schema.json#/$defs/uuid"
        },
        "clientId": {
          "$ref": "https://fixia.local/schemas/events/common.v1.schema.json#/$defs/uuid"
        },
        "providerId": {
          "$ref": "https://fixia.local/schemas/events/common.v1.schema.json#/$defs/uuid"
        },
        "price": {
          "$ref": "https://fixia.local/schemas/events/common.v1.schema.json#/$defs/money"
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "conditions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "agreedAt": {
          "$ref": "https://fixia.local/schemas/events/common.v1.schema.json#/$defs/instant"
        },
        "validUntil": {
          "$ref": "https://fixia.local/schemas/events/common.v1.schema.json#/$defs/instant"
        },
        "sentAt": {
          "$ref": "https://fixia.local/schemas/events/common.v1.schema.json#/$defs/instant"
        },
        "status": {
          "const": "SENT"
        },
        "replacedQuotations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "quotationId",
              "newStatus"
            ],
            "additionalProperties": false,
            "properties": {
              "quotationId": {
                "$ref": "https://fixia.local/schemas/events/common.v1.schema.json#/$defs/uuid"
              },
              "newStatus": {
                "type": "string",
                "enum": [
                  "SUPERSEDED",
                  "EXPIRED"
                ]
              }
            }
          }
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "description": "Número de versión de la cotización dentro de la solicitud (GC-427): 1 es la primera, 2 el primer ajuste. Opcional: los eventos anteriores a GC-427 no lo traen y los consumidores de la versión 1 original siguen siendo válidos."
        }
      }
    }
  }
}
