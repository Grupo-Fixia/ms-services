{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fixia.local/schemas/events/cotizacion.rechazada.v1.schema.json",
  "title": "cotizacion.rechazada (versión 1)",
  "description": "El cliente rechazó una cotización (RF-032, RF-033). La solicitud sigue con el mismo prestador seleccionado, que puede enviar otra.",
  "allOf": [
    {
      "$ref": "https://fixia.local/schemas/events/envelope.v1.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "cotizacion.rechazada"
    },
    "schemaVersion": {
      "const": 1
    },
    "actor": {
      "properties": {
        "role": {
          "const": "CLIENT"
        }
      }
    },
    "data": {
      "type": "object",
      "required": [
        "quotationId",
        "serviceRequestId",
        "clientId",
        "providerId",
        "price",
        "rejectedAt",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "quotationId": {
          "$ref": "https://fixia.local/schemas/events/common.v1.schema.json#/$defs/uuid"
        },
        "serviceRequestId": {
          "$ref": "https://fixia.local/schemas/events/common.v1.schema.json#/$defs/uuid"
        },
        "clientId": {
          "$ref": "https://fixia.local/schemas/events/common.v1.schema.json#/$defs/uuid"
        },
        "providerId": {
          "$ref": "https://fixia.local/schemas/events/common.v1.schema.json#/$defs/uuid"
        },
        "price": {
          "$ref": "https://fixia.local/schemas/events/common.v1.schema.json#/$defs/money"
        },
        "rejectedAt": {
          "$ref": "https://fixia.local/schemas/events/common.v1.schema.json#/$defs/instant"
        },
        "status": {
          "const": "REJECTED"
        }
      }
    }
  }
}
