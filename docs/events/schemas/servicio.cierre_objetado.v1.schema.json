{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fixia.local/schemas/events/servicio.cierre_objetado.v1.schema.json",
  "title": "servicio.cierre_objetado (versión 1)",
  "description": "El cliente no confirmó el cierre y lo objetó: la solicitud volvió de TECHNICIAN_FINISHED a IN_PROGRESS (GC-441). No es un cierre satisfactorio ni una disputa formal. El motivo no viaja en el evento (puede traer datos personales): queda en el historial de los participantes. Repetir la misma objeción no genera otro evento.",
  "allOf": [
    {
      "$ref": "https://fixia.local/schemas/events/envelope.v1.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "servicio.cierre_objetado"
    },
    "schemaVersion": {
      "const": 1
    },
    "actor": {
      "properties": {
        "role": {
          "const": "CLIENT"
        }
      }
    },
    "data": {
      "type": "object",
      "required": [
        "contractId",
        "serviceRequestId",
        "clientId",
        "providerId",
        "objectedAt",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "contractId": {
          "$ref": "https://fixia.local/schemas/events/common.v1.schema.json#/$defs/uuid"
        },
        "serviceRequestId": {
          "$ref": "https://fixia.local/schemas/events/common.v1.schema.json#/$defs/uuid"
        },
        "clientId": {
          "$ref": "https://fixia.local/schemas/events/common.v1.schema.json#/$defs/uuid"
        },
        "providerId": {
          "$ref": "https://fixia.local/schemas/events/common.v1.schema.json#/$defs/uuid"
        },
        "objectedAt": {
          "$ref": "https://fixia.local/schemas/events/common.v1.schema.json#/$defs/instant"
        },
        "status": {
          "const": "IN_PROGRESS"
        }
      }
    }
  }
}
