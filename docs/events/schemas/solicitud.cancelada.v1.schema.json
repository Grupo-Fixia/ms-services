{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fixia.local/schemas/events/solicitud.cancelada.v1.schema.json",
  "title": "solicitud.cancelada (versión 1)",
  "description": "El cliente canceló su solicitud antes de contratar (GC-515): desde PUBLISHED o PROVIDER_SELECTED. Las postulaciones que seguían pendientes quedan rechazadas en la misma transacción. Un servicio contratado no se cancela, así que nunca hay saldo retenido que liberar.",
  "allOf": [
    {
      "$ref": "https://fixia.local/schemas/events/envelope.v1.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "solicitud.cancelada"
    },
    "schemaVersion": {
      "const": 1
    },
    "actor": {
      "properties": {
        "role": {
          "const": "CLIENT"
        }
      }
    },
    "data": {
      "type": "object",
      "required": [
        "serviceRequestId",
        "clientId",
        "previousStatus",
        "selectedProviderId",
        "rejectedApplicationIds",
        "cancelledAt",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "serviceRequestId": {
          "$ref": "https://fixia.local/schemas/events/common.v1.schema.json#/$defs/uuid"
        },
        "clientId": {
          "$ref": "https://fixia.local/schemas/events/common.v1.schema.json#/$defs/uuid"
        },
        "previousStatus": {
          "type": "string",
          "enum": [
            "PUBLISHED",
            "PROVIDER_SELECTED"
          ],
          "description": "Estado desde el que se canceló."
        },
        "selectedProviderId": {
          "oneOf": [
            {
              "$ref": "https://fixia.local/schemas/events/common.v1.schema.json#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ],
          "description": "Prestador que estaba seleccionado; null si se canceló estando publicada."
        },
        "rejectedApplicationIds": {
          "type": "array",
          "items": {
            "$ref": "https://fixia.local/schemas/events/common.v1.schema.json#/$defs/uuid"
          },
          "uniqueItems": true,
          "description": "Postulaciones que seguían pendientes (APPLIED) y quedaron rechazadas por la cancelación."
        },
        "cancelledAt": {
          "$ref": "https://fixia.local/schemas/events/common.v1.schema.json#/$defs/instant"
        },
        "status": {
          "const": "CANCELLED"
        }
      }
    }
  }
}
